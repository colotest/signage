# Public — safe to expose to the browser; RLS restricts writes, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never import from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Email (resend.com). Without a key, development prints emails to the server
# log instead of sending them; production refuses to send.
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. Colo Cloud <noreply@example.com>
EMAIL_FROM=
# Where emailed links point, e.g. https://signage.example.com — set it in production.
APP_URL=
